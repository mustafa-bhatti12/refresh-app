# Supabase (Project Settings → API) — same project as refresh-web
# EXPO_PUBLIC_* is required for Expo to inline these client-side at build time
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Cloud Console → the existing "Web application" OAuth client refresh-web uses
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
